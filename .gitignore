# Ignore every file by default
*

# Keep folders visible so their .ps1 files can be found
!*/

# Ignore the app's own settings folder
.hormachuelos/

# Keep PowerShell scripts
!*.ps1

# Keep this .gitignore file itself
!.gitignore

# Keep the JIT page
!JIT/
!JIT/index.html

# Ignore the session log (never goes to the repo)
JIT/logs/session-log.json
